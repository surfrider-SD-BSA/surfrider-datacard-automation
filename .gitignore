# === Volunteer data — never commit ===
# Scanned data cards and generated spreadsheets contain personal information.
input/*
!input/.gitkeep
output/*
!output/.gitkeep

# === Python ===
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# === Claude Code ===
# Shared project settings (.claude/settings.json) ARE tracked.
# Per-developer overrides are not.
.claude/settings.local.json

# === Editors and OS ===
.DS_Store
.idea/
.vscode/
*.swp
*.swo
*~

# === Secrets ===
.env
.env.*
!.env.example
*.pem
*.key
