<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Data Cards</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<!-- App Store Connect asks about encryption on every upload and the answer
	     never changes: this app makes no network calls at all. The bundle is
	     served from inside the app package and the scan never leaves the
	     device, so there is nothing to declare. Xcode strips comments when it
	     rewrites this file; if this one is gone, that is why. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- The camera is used, and this key is required rather than optional:
	     without it iOS kills the app the moment the scanner is presented,
	     rather than refusing the picker.

	     It was deliberately absent until 22 August 2026, when photographing
	     the cards was added as its own button on the capture screen. The
	     objection that kept image input out was that a photograph held at an
	     angle keystones and registration does not correct for that; what
	     answers it is that capture goes through VisionKit's document scanner,
	     which rectifies the perspective before the image reaches the pipeline.
	     See ios/SurfriderDataCards/Tally/DocumentScanner.swift.

	     There is still no NSPhotoLibraryUsageDescription. Nothing here reads
	     the library or writes to it -- the scanner hands its pages straight
	     over -- and an app that asks for a permission it does not use is an
	     app that invites the question why. -->
	<key>NSCameraUsageDescription</key>
	<string>Tally photographs the cleanup data cards so it can find the boxes somebody wrote in. The pictures stay on this phone; only the finished spreadsheet is ever shared.</string>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
