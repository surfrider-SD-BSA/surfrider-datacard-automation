<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The App Group the share extension writes a shared scan into. Read by
	     SharedInbox, which will not guess if this is missing; the extension's
	     Info.plist sets the same key from the same build setting. -->
	<key>AppGroupIdentifier</key>
	<string>$(APP_GROUP_ID)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Data Cards</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<!-- Both from the build settings, and both for the same reason: the share
	     extension is a second bundle inside this one, and App Store Connect
	     rejects an upload whose extension does not carry the app's exact
	     version and build. Its Info.plist reads MARKETING_VERSION and
	     CURRENT_PROJECT_VERSION, so this one has to as well, or the two drift
	     the moment either is set.

	     It also makes testflight.sh's build number work. That script passes
	     CURRENT_PROJECT_VERSION=$(date +%s) so that every upload carries a
	     number nobody has used; while this key was the literal 1 the setting
	     reached nothing, and the second upload would have been refused as a
	     duplicate. -->
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- App Store Connect asks about encryption on every upload and the answer
	     never changes: this app makes no network calls at all. The bundle is
	     served from inside the app package and the scan never leaves the
	     device, so there is nothing to declare. Xcode strips comments when it
	     rewrites this file; if this one is gone, that is why. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- THERE IS NO NSCameraUsageDescription, AND ITS ABSENCE IS LOAD-BEARING.
	     Photographing the cards sits behind `Beta.cameraCapture` and does not
	     ship to the App Store, so the shipped binary never opens a camera. An app
	     that asks for a permission it does not use is an app that invites the
	     question why, and a reviewer who cannot find the feature a string is for
	     is a reviewer who writes to ask.

	     A BETA build needs the key back: iOS kills the app the moment the scanner
	     is presented without it, rather than refusing the picker. `BETA=1
	     ios/testflight.sh` adds it to the archive it builds. Belt and braces,
	     `Beta.cameraCapture` also checks for the key at runtime, so a BETA build
	     that somehow lacks it hides the button instead of crashing in a
	     volunteer's hand.

	     The history the old comment here carried, because it is still the reason
	     any of this exists: image input was deliberately absent until 22 August
	     2026. The objection that kept it out was that a photograph held at an
	     angle keystones and registration does not correct for that; what answers
	     it is that capture goes through VisionKit's document scanner, which
	     rectifies the perspective before the image reaches the pipeline. What is
	     still unanswered is resolution -- the reading wants 200 DPI on the card's
	     short edge -- and that is why the feature is in beta and this key is not
	     here. See ios/SurfriderDataCards/Tally/DocumentScanner.swift.

	     There is still no NSPhotoLibraryUsageDescription, for the original
	     reason: nothing here reads the library or writes to it. -->
	<!-- Accept a PDF from any other app: Files, Mail, Messages, AirDrop, the
	     share sheet. Getting a scan onto a phone is most of the work of using
	     this thing, and the document picker alone is a thin way to do it -- it
	     can only see what is already filed somewhere it can reach.

	     LSSupportsOpeningDocumentsInPlace is deliberately false. Opening in
	     place would give this app write access to the original, which it has
	     no business having; a copy in the inbox is all it needs, and
	     `openExternal` copies that out again before the system reclaims it.
	     Rank is Alternate because a PDF reader is a better default for a PDF
	     than this is. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Scanned data cards</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.adobe.pdf</string>
			</array>
		</dict>
	</array>
	<!-- `datacards://inbox` — the share extension's attempt to bring the app
	     forward after it has put a PDF in the drawer. It is only ever a nudge:
	     RootView checks the drawer whenever the app becomes active, so the scan
	     arrives whether or not this URL is ever opened, and nothing about the
	     file travels in it. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(APP_BUNDLE_ID)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>datacards</string>
			</array>
		</dict>
	</array>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<false/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
