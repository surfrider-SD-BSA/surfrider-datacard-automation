# Google Drive picker -- entirely optional.
#
# Copy this file to `.env.local` and fill it in to let people choose a scan out
# of the chapter's shared Drive folder instead of downloading it and dragging
# it in. Leave it alone, or delete the values, and the page works as it always
# has: drop a PDF, nothing leaves the laptop, no Google involved.
#
# Step-by-step setup, including what to click in the Google Cloud console, is
# in docs/google-drive.md.
#
# NONE OF THESE ARE SECRETS. Vite compiles `VITE_`-prefixed variables into the
# bundle, so every value here is readable by anyone who opens the page. That is
# fine for these -- a client ID names the app, and the API key is fenced in by
# the HTTP referrer allowlist you set on it -- and it is the reason nothing
# else may be put in this file. A build of this repository is published to
# GitHub Pages, so a secret in the environment is a secret on the open web.

# OAuth 2.0 Web client ID. Required.
VITE_GOOGLE_CLIENT_ID=

# Browser API key for the Picker, restricted by HTTP referrer. Required.
VITE_GOOGLE_API_KEY=

# The shared folder the picker should open on. Optional but strongly
# recommended -- without it the picker opens on "Recent", which is a list of
# everything except the scans. Paste either the folder's ID or the whole URL
# out of the address bar; both are understood.
VITE_GOOGLE_DRIVE_FOLDER_ID=

# Google Cloud project NUMBER (not the project ID). Needed only when the scans
# live on a shared drive rather than in somebody's My Drive. Harmless to set
# either way.
VITE_GOOGLE_APP_ID=

# "true" to show shared drives in the picker. Leave blank for My Drive folders.
VITE_GOOGLE_SHARED_DRIVES=
